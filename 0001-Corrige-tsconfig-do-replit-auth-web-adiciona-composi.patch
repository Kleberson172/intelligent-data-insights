From ee0ef5672931e4cae13e3f7edbe2fa13d1dd402c Mon Sep 17 00:00:00 2001
From: Kleberson172 <klebersonfilomeno172@gmail.com>
Date: Fri, 14 Aug 2026 22:28:19 +0000
Subject: [PATCH] Corrige tsconfig do replit-auth-web: adiciona composite:true

Faltava composite:true (e a configuracao de build associada) no
lib/replit-auth-web, obrigatorio para pacotes referenciados via
TypeScript project references. Isto quebrava o typecheck do
artifacts/eleven-tech.
---
 lib/replit-auth-web/tsconfig.json | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/lib/replit-auth-web/tsconfig.json b/lib/replit-auth-web/tsconfig.json
index 4d5196e..c5dd81e 100644
--- a/lib/replit-auth-web/tsconfig.json
+++ b/lib/replit-auth-web/tsconfig.json
@@ -1,6 +1,9 @@
 {
   "extends": "../../tsconfig.base.json",
   "compilerOptions": {
+    "composite": true,
+    "declarationMap": true,
+    "emitDeclarationOnly": true,
     "outDir": "dist",
     "rootDir": "src",
     "jsx": "react-jsx",
-- 
2.43.0

